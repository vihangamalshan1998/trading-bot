# Database Config
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=trading_user
MYSQL_PASSWORD=trading_password
MYSQL_DATABASE=ai_trading

# Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379

# Binance Futures API Keys
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=True

# News API Keys (For Macro State / Sentiment)
# You can get a free key from NewsAPI.org or similar
NEWS_API_KEY=your_news_api_key_here

# Gemini API Key for Advanced Sentiment NLP
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_VERSION=gemini-2.5-flash

# Trading Safety Gates (Phase 1 Controls)
TRADING_ENABLED=False
DRY_RUN=True
ALLOW_TESTNET=True
ALLOW_LIVE_TRADING=False
EMERGENCY_STOP=False

# Institutional Upgrade 1: Macro & Flash-Crash Shield
MACRO_FLASH_CRASH_THRESHOLD_PCT=0.025
MACRO_FLASH_CRASH_LOCKOUT_SECONDS=1800.0
ECONOMIC_SHIELD_ENABLED=True
ECONOMIC_SHIELD_BUFFER_MINUTES=15.0

# Institutional Upgrade 2: Multi-Exchange Liquidation Cascade Hunter
LIQUIDATION_CASCADE_HUNTER_ENABLED=True
LIQUIDATION_CASCADE_THRESHOLD_USD=20000000.0

# Institutional Upgrade 3: Market-Beta Hedger (Delta-Neutral)
BETA_HEDGING_ENABLED=True
BETA_HEDGE_RATIO=1.0
BETA_HEDGE_REBALANCE_THRESHOLD_USD=250.0

# Institutional Upgrade 4: Interactive Telegram Command Center
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=False
